{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "initial-version": "1.3.0",
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this tags the commit, publishes a GitHub release, and the Release workflow attaches the addon's zip to it.",
  "packages": {
    ".": {
      "package-name": "PITarget",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["PITarget/PITarget.toc"]
    }
  }
}
